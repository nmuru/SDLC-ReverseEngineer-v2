MODEL_PROVIDER=anthropic
# ANTHROPIC_MODEL defaults to the model configured in app/config.py
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: OpenAI Agents SDK tracing exporter key.
# Used only to export traces to the OpenAI Traces dashboard; it is not used for model calls.
OPENAI_TRACING_API_KEY=your_openai_tracing_api_key
